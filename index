// ==================== UTILITIES: NOTIFICATIONS, QR & DARK MODE ====================
function pushNotification(userId, message, type) {
    db.Notifications.unshift({
        NotificationID: 'NTF' + Date.now(),
        UserID: userId,
        Message: message,
        Type: type,
        Status: 'Unread',
        CreateDate: getNowThai()
    });
}

function renderNotifications() {
    const list = db.Notifications.filter(n => n.UserID === 'ALL' || n.UserID === currentUser.UserID);
    const unread = list.filter(n => n.Status === 'Unread').length;
    const badge = document.getElementById('notifBadge');
    badge.textContent = unread;
    badge.classList.toggle('hidden', unread === 0);

    document.getElementById('notifListContainer').innerHTML = list.map(n => `
        <div class="p-3 text-xs ${n.Status === 'Unread' ? 'bg-blue-50/60 dark:bg-slate-700/60 font-semibold' : ''}">
            <div>${sanitizeHTML(n.Message)}</div>
            <div class="text-[10px] text-slate-400 mt-1">${n.CreateDate}</div>
        </div>
    `).join('');
}

function toggleNotifPanel() {
    document.getElementById('notifDropdown').classList.toggle('hidden');
}

function markAllNotifRead() {
    db.Notifications.forEach(n => { n.Status = 'Read'; });
    saveDB();
    renderNotifications();
}

function openQrCheckinModal() {
    const checkInUrl = `${window.location.href.split('#')[0]}?checkin=${currentUser.UserID}`;
    document.getElementById('classroomQrImg').src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(checkInUrl)}`;
    document.getElementById('qrStudentRef').textContent = `${currentUser.UserID} (${currentUser.FullName})`;
    document.getElementById('qrCheckinModal').classList.remove('hidden');
}

function simulateQrAttendanceCheck() {
    closeModal('qrCheckinModal');
    Swal.fire({
        icon: 'success',
        title: 'เช็คชื่อเข้าเรียนด้วย QR Code สำเร็จ!',
        text: `บันทึกเวลาเข้าเรียนของ ${currentUser.FullName} ณ เวลา ${getNowThai()} เรียบร้อยแล้ว`,
        confirmButtonColor: '#2563eb'
    });
}

function toggleDarkMode() {
    const html = document.documentElement;
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    document.getElementById('darkModeIcon').className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
}

function toggleMobileSidebar() {
    document.getElementById('sidebarPanel').classList.toggle('-translate-x-full');
}

function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
}
</script>
</body>
</html>
