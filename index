document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const identity = document.getElementById('loginIdentity').value.trim();
    const pass = document.getElementById('loginPass').value.trim();
    authenticateUser(identity, pass);
});

function quickDemoLogin(identity, pass) {
    document.getElementById('loginIdentity').value = identity;
    document.getElementById('loginPass').value = pass;
    authenticateUser(identity, pass);
}

function authenticateUser(identity, pass) {
    const user = db.Users.find(u =>
        (u.UserID.toLowerCase() === identity.toLowerCase() || u.Email.toLowerCase() === identity.toLowerCase()) &&
        String(u.Password) === String(pass)
    );
    if (!user) {
        Swal.fire({ icon: 'error', title: 'เข้าสู่ระบบไม่สำเร็จ', text: 'รหัสประจำตัว/อีเมล หรือรหัสผ่านไม่ถูกต้อง', confirmButtonColor: '#1d4ed8' });
        return;
    }
    user.LastLogin = getNowThai();
    saveDB();
    currentUser = user;
    sessionStorage.setItem('edulearn_session_user', JSON.stringify(user));
    Swal.fire({ icon: 'success', title: `ยินดีต้อนรับ ${user.FullName}`, text: `สิทธิ์การใช้งาน: ${user.Role}`, timer: 1300, showConfirmButton: false });
    launchPlatform();
}

function handleGoogleLogin() {
    Swal.fire({
        title: 'เลือกบัญชี Google ของสถานศึกษา',
        input: 'select',
        inputOptions: {
            'STU001': 'manee@school.ac.th (นักเรียน - ม.6/1)',
            'TCH001': 'teacher@school.ac.th (ครูผู้สอน)',
            'ADM001': 'admin@school.ac.th (ผู้ดูแลระบบ)'
        },
        showCancelButton: true,
        confirmButtonText: 'ดำเนินการต่อ',
        confirmButtonColor: '#1d4ed8'
    }).then(res => {
        if (res.isConfirmed && res.value) {
            const u = db.Users.find(x => x.UserID === res.value);
            if (u) authenticateUser(u.UserID, u.Password);
        }
    });
}

