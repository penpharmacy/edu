function exportReportExcel() {
    const headers = ['StudentID,FullName,Class,CompletedLessons,TotalMinutes,BestScorePercent'];
    const rows = db.Users.filter(u => u.Role === 'Student').map(stu => {
        const progs = db.Progress.filter(p => p.StudentID === stu.UserID && p.Status === 'Completed');
        const mins = progs.reduce((a, b) => a + (Number(b.TimeSpent) || 0), 0);
        const scores = db.Scores.filter(s => s.StudentID === stu.UserID);
        const best = scores.length ? Math.max(...scores.map(s => s.Percent)) : 0;
        return `"${stu.UserID}","${stu.FullName}","${stu.Class}",${progs.length},${mins},${best}`;
    });
    const csv = 'data:text/csv;charset=utf-8,\uFEFF' + [headers, ...rows].join('\n');
    const link = document.createElement('a');
    link.href = encodeURI(csv);
    link.download = 'Elearning_Student_Report.csv';
    link.click();
}

