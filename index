function markCurrentLessonComplete(courseId, lessonId) {
    const addedMinutes = Math.max(1, Math.ceil(activeLearningSession.secondsElapsed / 60));
    let rec = db.Progress.find(p => p.StudentID === currentUser.UserID && p.LessonID === lessonId);
    if (rec) {
        rec.Status = 'Completed';
        rec.TimeSpent = (Number(rec.TimeSpent) || 0) + addedMinutes;
        rec.LastAccess = getNowThai();
        rec.CompleteDate = getNowThai().split(' ')[0];
    } else {
        db.Progress.push({
            ProgressID: 'PRG' + Date.now(),
            StudentID: currentUser.UserID,
            CourseID: courseId,
            LessonID: lessonId,
            Status: 'Completed',
            TimeSpent: addedMinutes,
            LastAccess: getNowThai(),
            CompleteDate: getNowThai().split(' ')[0]
        });
    }
    saveDB();
    Swal.fire({
        icon: 'success',
        title: 'บันทึกความคืบหน้าสำเร็จ!',
        text: `ระบบบันทึกเวลาเรียนเพิ่ม ${addedMinutes} นาที และทำเครื่องหมายเรียนจบบทนี้แล้ว`,
        confirmButtonColor: '#059669'
    }).then(() => openCoursePlayer(courseId, lessonId));
