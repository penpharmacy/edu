<!DOCTYPE html>
<html lang="th" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบบทเรียนออนไลน์ E-Learning Platform (Modern Education)</title>
    <!-- Google Fonts: Prompt / Noto Sans Thai -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Noto Sans Thai', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- HTML2Canvas & jsPDF for Certificate & Report Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <style>
        body { font-family: 'Noto Sans Thai', sans-serif; transition: background-color 0.25s, color 0.25s; }
        .glass-card { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); }
        .dark .glass-card { background: rgba(30, 41, 59, 0.92); }
        .sidebar-link { transition: all 0.2s ease; }
        .sidebar-link.active { background: linear-gradient(90deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff !important; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25); }
        .cert-border { border: 10px double #1e3a8a; background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%); }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen flex flex-col">

<!-- ==================== 1. หน้าเข้าสู่ระบบ (Authentication View) ==================== -->
<div id="authScreen" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-blue-900 via-blue-700 to-sky-500">
    <div class="max-w-md w-full bg-white dark:bg-slate-800 rounded-3xl shadow-2xl p-6 sm:p-8 animate__animated animate__fadeInUp">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-blue-600 text-white flex items-center justify-center mx-auto mb-3 shadow-lg shadow-blue-500/30">
                <i class="fa-solid fa-graduation-cap text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-blue-900 dark:text-white">EduLearn Platform</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">ระบบบทเรียนออนไลน์อัจฉริยะสำหรับสถานศึกษา</p>
        </div>

        <!-- Tabs: Login / Verify Certificate -->
        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 dark:bg-slate-700 rounded-xl mb-5 text-sm font-medium">
            <button onclick="switchAuthTab('login')" id="tabBtnLogin" class="py-2 rounded-lg bg-white dark:bg-slate-800 text-blue-700 dark:text-blue-400 shadow-sm">เข้าสู่ระบบ</button>
            <button onclick="switchAuthTab('verify')" id="tabBtnVerify" class="py-2 rounded-lg text-slate-600 dark:text-slate-300">ตรวจสอบเกียรติบัตร</button>
        </div>

        <!-- Login Form -->
        <form id="loginForm" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">รหัสนักเรียน / อีเมล / ชื่อผู้ใช้</label>
                <div class="relative">
                    <i class="fa-solid fa-user-astronaut absolute left-3.5 top-3.5 text-slate-400"></i>
                    <input type="text" id="loginIdentity" required placeholder="เช่น STU001 หรือ admin" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:ring-2 focus:ring-blue-500 outline-none text-sm">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">รหัสผ่าน</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-400"></i>
                    <input type="password" id="loginPass" required placeholder="รหัสผ่าน" class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:ring-2 focus:ring-blue-500 outline-none text-sm">
                </div>
            </div>
            <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-800 to-blue-600 hover:from-blue-900 hover:to-blue-700 text-white font-semibold shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-right-to-bracket"></i> เข้าสู่ระบบ
            </button>
            <button type="button" onclick="handleGoogleLogin()" class="w-full py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 font-medium text-sm transition flex items-center justify-center gap-2">
                <i class="fa-brands fa-google text-red-500"></i> เข้าสู่ระบบด้วย Google Account
            </button>
        </form>

        <!-- Verify Certificate Form (Public) -->
        <div id="verifyBox" class="hidden space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">หมายเลขเกียรติบัตร (Certificate ID)</label>
                <input type="text" id="publicCertId" placeholder="เช่น CERT-2569-1001" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-900 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="button" onclick="verifyCertificatePublic()" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition">
                <i class="fa-solid fa-shield-check mr-1"></i> ตรวจสอบความถูกต้อง
            </button>
            <div id="publicVerifyResult"></div>
        </div>

        <!-- Quick Demo Role Switcher -->
        <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-700">
            <p class="text-xs text-center text-slate-400 mb-2">ทดลองเข้าใช้งานด่วน (Demo Role-Based Access)</p>
            <div class="grid grid-cols-3 gap-2 text-xs">
                <button onclick="quickDemoLogin('admin', 'pen123456')" class="py-2 px-2 rounded-lg bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 font-semibold border border-rose-200 dark:border-rose-800 hover:bg-rose-100">
                    <i class="fa-solid fa-user-shield block mb-0.5"></i> Admin
                </button>
                <button onclick="quickDemoLogin('TCH001', '123456')" class="py-2 px-2 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-semibold border border-blue-200 dark:border-blue-800 hover:bg-blue-100">
                    <i class="fa-solid fa-chalkboard-user block mb-0.5"></i> ครูผู้สอน
                </button>
                <button onclick="quickDemoLogin('STU001', '123456')" class="py-2 px-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100">
                    <i class="fa-solid fa-user-graduate block mb-0.5"></i> นักเรียน
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== 2. หน้าหลักของระบบ (Main Platform Layout) ==================== -->
<div id="appLayout" class="hidden min-h-screen flex flex-col">
    <!-- Top Navbar -->
    <header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-800/90 backdrop-blur border-b border-slate-200 dark:border-slate-700 px-4 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <button onclick="toggleMobileSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700">
                <i class="fa-solid fa-bars text-lg"></i>
            </button>
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-900 to-blue-500 text-white flex items-center justify-center shadow">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>
            <div>
                <div class="font-bold text-blue-900 dark:text-white leading-tight">EduLearn LMS</div>
                <div class="text-xs text-slate-500 dark:text-slate-400">Modern School E-Learning</div>
            </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-4">
            <!-- QR Check-in Button -->
            <button onclick="openQrCheckinModal()" class="hidden sm:flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-xl bg-blue-50 dark:bg-slate-700 text-blue-700 dark:text-blue-300 hover:bg-blue-100 transition">
                <i class="fa-solid fa-qrcode"></i> QR เข้าเรียน
            </button>

            <!-- Dark Mode Toggle -->
            <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-amber-400 hover:scale-105 transition" title="สลับโหมดมืด/สว่าง">
                <i id="darkModeIcon" class="fa-solid fa-moon"></i>
            </button>

            <!-- Notification Dropdown -->
            <div class="relative">
                <button onclick="toggleNotifPanel()" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center relative hover:scale-105 transition">
                    <i class="fa-solid fa-bell text-slate-600 dark:text-slate-200"></i>
                    <span id="notifBadge" class="hidden absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full">0</span>
                </button>
                <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden z-50">
                    <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
                        <span class="font-bold text-sm">การแจ้งเตือนระบบ</span>
                        <span class="text-xs text-blue-600 cursor-pointer" onclick="markAllNotifRead()">อ่านทั้งหมด</span>
                    </div>
                    <div id="notifListContainer" class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700"></div>
                </div>
            </div>

            <!-- User Profile Chip -->
            <div class="flex items-center gap-2.5 pl-2 border-l border-slate-200 dark:border-slate-700">
                <img id="navUserAvatar" src="https://ui-avatars.com/api/?name=User&background=1E3A8A&color=fff" class="w-9 h-9 rounded-full object-cover ring-2 ring-blue-500/30" alt="avatar">
                <div class="hidden md:block text-left">
                    <div id="navUserName" class="text-xs font-bold leading-none">ชื่อผู้ใช้</div>
                    <span id="navUserRole" class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 font-semibold inline-block mt-1">Role</span>
                </div>
                <button onclick="logoutSystem()" class="p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-xl transition" title="ออกจากระบบ">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Body Split: Sidebar + Content -->
    <div class="flex-1 flex overflow-hidden">
        <!-- Animated Sidebar -->
        <aside id="sidebarPanel" class="fixed lg:static inset-y-0 left-0 z-20 w-64 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 p-4 flex flex-col justify-between transform -translate-x-full lg:translate-x-0 transition-transform duration-300">
            <div class="space-y-1 mt-12 lg:mt-0" id="sidebarMenuContainer">
                <!-- Populated by Role -->
            </div>
            <div class="p-3.5 rounded-2xl bg-gradient-to-br from-blue-900 to-blue-700 text-white text-xs space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-bold"><i class="fa-brands fa-line text-emerald-300 mr-1"></i> LINE & Email Notify</span>
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                </div>
                <p class="text-blue-100 text-[11px]">ระบบเชื่อมต่อ Google Sheets & แจ้งเตือนอัตโนมัติพร้อมใช้งาน</p>
            </div>
        </aside>

        <!-- Dynamic View Content -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-8 space-y-6" id="mainViewContent">
            <!-- Rendered dynamically -->
        </main>
    </div>
</div>

<!-- ==================== 3. MODALS (เพิ่ม/แก้ไขคอร์ส, บทเรียน, ข้อสอบ, QR, เกียรติบัตร) ==================== -->

<!-- Course Modal -->
<div id="courseModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-lg w-full p-6 shadow-2xl animate__animated animate__zoomIn animate__faster">
        <div class="flex justify-between items-center pb-3 border-b border-slate-100 dark:border-slate-700 mb-4">
            <h3 class="font-bold text-lg text-blue-900 dark:text-white"><i class="fa-solid fa-layer-group mr-2"></i>จัดการรายวิชา / คอร์สเรียน</h3>
            <button onclick="closeModal('courseModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
        </div>
        <form id="courseForm" class="space-y-3 text-sm">
            <input type="hidden" id="fmCourseId">
            <div>
                <label class="font-semibold block mb-1">ชื่อรายวิชา / คอร์สเรียน *</label>
                <input type="text" id="fmCourseName" required class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900" placeholder="เช่น วิทยาการคำนวณ และ AI เบื้องต้น">
            </div>
            <div>
                <label class="font-semibold block mb-1">คำอธิบายรายวิชา</label>
                <textarea id="fmCourseDesc" rows="2" class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="font-semibold block mb-1">เกณฑ์คะแนนสอบผ่าน (%)</label>
                    <input type="number" id="fmCoursePass" value="70" min="1" max="100" required class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
                </div>
                <div>
                    <label class="font-semibold block mb-1">จำนวนบทเรียนทั้งหมด</label>
                    <input type="number" id="fmCourseTotalLessons" value="2" min="1" required class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
                </div>
            </div>
            <div>
                <label class="font-semibold block mb-1">URL รูปปกคอร์สเรียน</label>
                <input type="url" id="fmCourseCover" placeholder="https://images.unsplash.com/..." class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
            </div>
            <div class="flex justify-end gap-2 pt-3">
                <button type="button" onclick="closeModal('courseModal')" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 font-medium">ยกเลิก</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold">บันทึกคอร์ส</button>
            </div>
        </form>
    </div>
</div>

<!-- Lesson Modal -->
<div id="lessonModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-xl w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center pb-3 border-b border-slate-100 dark:border-slate-700 mb-4">
            <h3 class="font-bold text-lg text-blue-900 dark:text-white"><i class="fa-solid fa-book-medical mr-2"></i>เพิ่ม / แก้ไขบทเรียน</h3>
            <button onclick="closeModal('lessonModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
        </div>
        <form id="lessonForm" class="space-y-3 text-sm">
            <input type="hidden" id="fmLessonId">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="font-semibold block mb-1">เลือกรายวิชา (Course) *</label>
                    <select id="fmLessonCourseId" required class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900"></select>
                </div>
                <div>
                    <label class="font-semibold block mb-1">หมวดหมู่รายวิชา (Category)</label>
                    <input type="text" id="fmLessonCategory" placeholder="เช่น วิทยาศาสตร์ / เภสัชกรรม" required class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
                </div>
            </div>
            <div>
                <label class="font-semibold block mb-1">ชื่อบทเรียน (Title) *</label>
                <input type="text" id="fmLessonTitle" required placeholder="เช่น บทที่ 1: พื้นฐานสำคัญและการประยุกต์ใช้" class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
            </div>
            <div>
                <label class="font-semibold block mb-1">เนื้อหาบทเรียน (Description / HTML)</label>
                <textarea id="fmLessonDesc" rows="3" required class="w-full px-3.5 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900" placeholder="สรุปเนื้อหาใจความสำคัญของบทเรียน..."></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="font-semibold block mb-1 text-xs"><i class="fa-brands fa-youtube text-red-500 mr-1"></i>YouTube Embed URL</label>
                    <input type="url" id="fmLessonVideo" placeholder="https://www.youtube.com/embed/..." class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900 text-xs">
                </div>
                <div>
                    <label class="font-semibold block mb-1 text-xs"><i class="fa-solid fa-file-pdf text-rose-500 mr-1"></i>ลิงก์เอกสาร PDF / Drive</label>
                    <input type="url" id="fmLessonPdf" placeholder="https://drive.google.com/..." class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900 text-xs">
                </div>
                <div>
                    <label class="font-semibold block mb-1 text-xs"><i class="fa-solid fa-image text-emerald-500 mr-1"></i>URL รูปภาพประกอบ</label>
                    <input type="url" id="fmLessonImg" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900 text-xs">
                </div>
            </div>
            <div class="flex justify-end gap-2 pt-3">
                <button type="button" onclick="closeModal('lessonModal')" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 font-medium">ยกเลิก</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold">บันทึกบทเรียน</button>
            </div>
        </form>
    </div>
</div>

<!-- Quiz Question Modal -->
<div id="quizModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-lg w-full p-6 shadow-2xl">
        <div class="flex justify-between items-center pb-3 border-b border-slate-100 dark:border-slate-700 mb-4">
            <h3 class="font-bold text-lg text-blue-900 dark:text-white"><i class="fa-solid fa-circle-question mr-2"></i>เพิ่ม / แก้ไขข้อสอบปรนัย 4 ตัวเลือก</h3>
            <button onclick="closeModal('quizModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
        </div>
        <form id="quizFormModal" class="space-y-3 text-sm">
            <input type="hidden" id="fmQuizId">
            <div>
                <label class="font-semibold block mb-1">รายวิชา (Course) *</label>
                <select id="fmQuizCourseId" required class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900"></select>
            </div>
            <div>
                <label class="font-semibold block mb-1">คำถาม (Question) *</label>
                <textarea id="fmQuizQuestion" rows="2" required class="w-full px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <input type="text" id="fmChoiceA" required placeholder="ตัวเลือก A" class="px-3 py-2 rounded-xl border dark:border-slate-700 dark:bg-slate-900">
