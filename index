function shuffleArray(arr) {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
}

function startCourseQuiz(courseId) {
    const course = db.Courses.find(c => c.CourseID === courseId);
    const rawQuestions = db.Quiz.filter(q => q.CourseID === courseId);
    if (!rawQuestions.length) {
        Swal.fire('ยังไม่มีข้อสอบ', 'รายวิชานี้ยังไม่ได้เพิ่มข้อสอบในระบบ', 'warning');
        return;
    }

    // Randomize Questions & Choices
    const randomizedQuestions = shuffleArray(rawQuestions).map(q => {
        const choices = shuffleArray([
            { key: 'A', text: q.ChoiceA },
            { key: 'B', text: q.ChoiceB },
            { key: 'C', text: q.ChoiceC },
            { key: 'D', text: q.ChoiceD }
        ]);
        return { ...q, shuffledChoices: choices };
    });

    let remainingSeconds = randomizedQuestions.length * 60; // 1 min per question
    const container = document.getElementById('mainViewContent');

    container.innerHTML = `
        <div class="max-w-3xl mx-auto space-y-5">
            <div class="bg-blue-900 text-white p-5 rounded-3xl flex justify-between items-center shadow-lg sticky top-20 z-10">
                <div>
                    <div class="text-xs text-blue-200">แบบทดสอบวัดผลรายวิชา (Random Mode)</div>
                    <h3 class="font-bold text-base">${sanitizeHTML(course.CourseName)}</h3>
                </div>
                <div class="px-4 py-2 rounded-2xl bg-white/15 font-mono font-bold text-sm">
                    <i class="fa-solid fa-clock mr-1 text-amber-300"></i> <span id="quizCountdown">05:00</span>
                </div>
            </div>

            <form id="activeQuizForm" class="space-y-4">
                ${randomizedQuestions.map((q, idx) => `
                    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
                        <div class="font-bold text-sm mb-3">ข้อที่ ${idx + 1}. ${sanitizeHTML(q.Question)} <span class="text-xs text-blue-600">(${q.Score} คะแนน)</span></div>
                        <div class="space-y-2">
                            ${q.shuffledChoices.map(ch => `
                                <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-blue-50 dark:hover:bg-slate-700 cursor-pointer text-xs">
                                    <input type="radio" name="q_${q.QuizID}" value="${ch.key}" required class="text-blue-600">
                                    <span>${sanitizeHTML(ch.text)}</span>
                                </label>
                            `).join('')}
                        </div>
                    </div>
                `).join('')}
                <button type="submit" class="w-full py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg">
                    <i class="fa-solid fa-paper-plane mr-1"></i> ส่งกระดาษคำตอบและตรวจคะแนนทันที
                </button>
            </form>
            <div id="quizAnswerReviewBox"></div>
        </div>
    `;

    if (activeQuizTimer) clearInterval(activeQuizTimer);
    activeQuizTimer = setInterval(() => {
        remainingSeconds--;
        const m = String(Math.floor(remainingSeconds / 60)).padStart(2, '0');
        const s = String(remainingSeconds % 60).padStart(2, '0');
        const el = document.getElementById('quizCountdown');
        if (el) el.textContent = `${m}:${s}`;
        if (remainingSeconds <= 0) {
            clearInterval(activeQuizTimer);
            document.getElementById('activeQuizForm')?.requestSubmit();
        }
    }, 1000);

    document.getElementById('activeQuizForm').addEventListener('submit', (e) => {
        e.preventDefault();
        clearInterval(activeQuizTimer);

        let earned = 0, total = 0;
        const reviewHtml = randomizedQuestions.map((q, idx) => {
            total += Number(q.Score);
            const selected = document.querySelector(`input[name="q_${q.QuizID}"]:checked`)?.value || '-';
            const isCorrect = selected === q.CorrectAnswer;
            if (isCorrect) earned += Number(q.Score);
            const correctText = q['Choice' + q.CorrectAnswer];
            return `
                <div class="p-4 rounded-2xl border text-xs ${isCorrect ? 'bg-emerald-50 border-emerald-200 dark:bg-emerald-950/40' : 'bg-rose-50 border-rose-200 dark:bg-rose-950/40'}">
                    <div class="font-bold">${idx + 1}. ${sanitizeHTML(q.Question)}</div>
                    <div class="mt-1">คำตอบของคุณ: <strong>${selected}</strong> | เฉลยที่ถูกต้อง: <strong class="text-emerald-700 dark:text-emerald-300">${q.CorrectAnswer} (${sanitizeHTML(correctText)})</strong></div>
                </div>
            `;
        }).join('');

        const pct = Math.round((earned / total) * 100);
        const passed = pct >= course.PassScore;

        db.Scores.push({
            ScoreID: 'SCR' + Date.now(),
            StudentID: currentUser.UserID,
            CourseID: course.CourseID,
            Score: earned,
            Total: total,
            Percent: pct,
            SubmitDate: getNowThai()
        });

        // Auto-generate Certificate if Passed
        let certGenerated = null;
        if (passed) {
            certGenerated = db.Certificates.find(c => c.StudentID === currentUser.UserID && c.CourseName === course.CourseName);
            if (!certGenerated) {
                const newCertId = `CERT-2569-${1000 + db.Certificates.length + 1}`;
                certGenerated = {
                    CertificateID: newCertId,
                    StudentID: currentUser.UserID,
                    FullName: currentUser.FullName,
                    CourseName: course.CourseName,
                    Score: pct,
                    PDFURL: '#',
                    VerifyURL: `https://edulearn.school.ac.th/verify?id=${newCertId}`,
                    IssueDate: getNowThai().split(' ')[0],
                    Status: 'Verified'
                };
                db.Certificates.push(certGenerated);
                pushNotification(currentUser.UserID, `🎓 ยินดีด้วย! คุณสอบผ่านวิชา "${course.CourseName}" (${pct}%) ได้รับเกียรติบัตร ${newCertId}`, 'Certificate');
            }
        }
        saveDB();
        renderNotifications();

        document.getElementById('quizAnswerReviewBox').innerHTML = `
            <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl shadow-lg border border-slate-200 dark:border-slate-700 space-y-4">
                <div class="text-center">
                    <div class="text-3xl font-extrabold ${passed ? 'text-emerald-600' : 'text-rose-600'}">คะแนนของคุณ: ${earned}/${total} (${pct}%)</div>
                    <p class="text-xs text-slate-500 mt-1">${passed ? '🎉 ผ่านเกณฑ์มาตรฐาน! ระบบออกเกียรติบัตรให้คุณเรียบร้อยแล้ว' : 'ยังไม่ผ่านเกณฑ์ขั้นต่ำ สามารถทบทวนบทเรียนและสอบใหม่ได้'}</p>
                    ${certGenerated ? `<button onclick="previewCertificate('${certGenerated.CertificateID}')" class="mt-3 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow"><i class="fa-solid fa-award mr-1"></i> เปิดดูและดาวน์โหลดเกียรติบัตร</button>` : ''}
                </div>
                <h4 class="font-bold text-sm border-t pt-4">เฉลยละเอียดรายข้อ:</h4>
                <div class="space-y-2">${reviewHtml}</div>
            </div>
        `;
        Swal.fire({
            icon: passed ? 'success' : 'info',
            title: passed ? `สอบผ่าน! ได้คะแนน ${pct}%` : `ได้คะแนน ${pct}%`,
            text: passed ? 'ระบบสร้างเกียรติบัตรพร้อม QR Verify และส่งแจ้งเตือน LINE แล้ว' : 'ดูเฉลยด้านล่างเพื่อทบทวนความรู้ได้เลยครับ'
        });
    });
}

